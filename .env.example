# Server-only. Do not prefix either key with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Transactional email (Resend). Without these the signup still saves.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Admin notification. Telegram is used when both are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Fallback admin notification when Telegram is not configured.
ADMIN_NOTIFICATION_EMAIL=

# Optional verified social profile URLs. Missing URLs render as inactive labels.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
